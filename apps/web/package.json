{
  "name": "evalops-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test runtime-focus-smoke.spec.ts",
    "test:browser:smoke:headed": "playwright test runtime-focus-smoke.spec.ts --headed",
    "test:browser:product-focus": "playwright test --config=playwright.product.config.ts",
    "test:browser:product-focus:headed": "playwright test --config=playwright.product.config.ts --headed"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.18",
    "typescript": "5.6.3"
  }
}
