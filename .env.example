# Copy this file to .env for local setup. Fill with safe local values only.

# Frontend

NEXT_PUBLIC_APP_NAME=evalops
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database

DATABASE_URL=postgresql+asyncpg://replace-with-db-user:replace-with-db-password@localhost:5432/evalops_local
DB_NAME=evalops_local

# Cache / queues

REDIS_URL=redis://localhost:6379/0

# Object storage

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-local-access-key
MINIO_SECRET_KEY=replace-with-local-secret-key
MINIO_BUCKET_NAME=evalops-dev

# Provider credentials placeholders

OPENAI_API_KEY=replace-with-your-api-key
